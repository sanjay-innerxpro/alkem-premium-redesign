{
  "name": "alkem-nextjs-cms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.mjs",
    "admin:create": "node --env-file-if-exists=.env.local --import tsx scripts/create-admin.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env.local --import tsx --test tests/*.integration.ts"
  },
  "dependencies": {
    "mysql2": "^3.15.0",
    "next": "^16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
