DATABASE_URL=mysql://alkem:change-me@127.0.0.1:3306/alkem_cms
APP_URL=http://localhost:3000
# Only enable for a read-only design preview. All database writes and admin login are disabled.
DEMO_MODE=false
# Set true behind HTTPS in production; false only for localhost testing.
COOKIE_SECURE=false
# Production remote database only: true to verify TLS against system roots.
DATABASE_SSL=false
# Only behind a trusted reverse proxy that overwrites X-Forwarded-For:
TRUST_PROXY=false
# Android app (Trusted Web Activity), see android/README.md. Leave empty until the app is signed.
# Both comma-separated: app IDs (store app and its .test build), and the SHA-256 fingerprints
# of the debug, upload and Play App Signing keys.
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=
